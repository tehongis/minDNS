# minDNS Configuration File

# Upstream DNS server
upstream_ip = 8.8.8.8
upstream_port = 53

# Local listening address
listen_ip = 127.0.0.1
listen_port = 53

# Blocklist file
blocklist_file = minDNS.block

# Cache file
cache_file = minDNS.cache

# Log file
log_file = minDNS.log

# Daemonize
daemonize = 0

# Maximum cache size
max_cache_size = 10000